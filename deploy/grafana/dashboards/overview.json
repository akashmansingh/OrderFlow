      "title": "Infra Dashboard",
      "tooltip": "Open Infrastructure Dashboard",
      "type": "link",
      "url": "/d/orderflow-infra/orderflow-infrastructure-resources"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Service Level Objectives (SLOs) & Critical Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "expr": "(sum(rate(orderflow_http_requests_total{status=~\"5..\"}[1h])) / clamp_min(sum(rate(orderflow_http_requests_total[1h])), 1)) / 0.001",
          "legendFormat": "1h Error Budget Burn Rate",
          "refId": "A"
        }
      ],
      "title": "Availability SLO Burn Rate (1h)",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 30 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "expr": "orderflow_outbox_oldest_row_age_seconds",
          "legendFormat": "Oldest Outbox Age",
          "refId": "A"
        }
      ],
      "title": "Stuck Sagas (Oldest Outbox Age)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "job:orderflow_http_errors:ratio5m",
          "legendFormat": "5xx Error Ratio (5m)",
          "refId": "A"
        }
      ],
      "title": "HTTP Error Ratio (5m Window)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 5,
      "title": "HTTP Traffic & Latency Quantiles",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "sum by (status) (job:orderflow_http_requests:rate5m)",
          "legendFormat": "Status {{ status }}",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Throughput by Status (RPS)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "max(job:orderflow_http_duration_seconds:p50)",
          "legendFormat": "p50 (Median)",
          "refId": "A"
        },
        {
          "expr": "max(job:orderflow_http_duration_seconds:p95)",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "max(job:orderflow_http_duration_seconds:p99)",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "HTTP Request Latency Quantiles (Recording Rules)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 8,
      "title": "Saga Transitions & Outbox Lifecycle",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(orderflow_worker_events_processed_total[5m]))",
          "legendFormat": "Saga outcome: {{ outcome }}",
          "refId": "A"
        }
      ],
      "title": "Saga Completion Throughput by Outcome",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "job:orderflow_worker_saga_duration_seconds:p95",
          "legendFormat": "Saga p95 ({{ outcome }})",
          "refId": "A"
        }
      ],
      "title": "End-to-End Saga Latency (p95)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["orderflow", "production", "overview"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "production", "value": "production" },
        "hide": 0,
        "name": "environment",
        "options": [
          { "selected": true, "text": "production", "value": "production" },
          { "selected": false, "text": "development", "value": "development" }
        ],
        "query": "production,development",
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "OrderFlow - Executive & API Overview",
  "uid": "orderflow-overview",
  "version": 1
}
