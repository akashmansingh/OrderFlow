{
    email {$ACME_EMAIL:admin@orderflow.example}
    admin off
}

# Public API Gateway
api.{$DOMAIN:localhost} {
    # Block internal metrics endpoint from public exposure
    @metrics {
        path /metrics
        path /metrics/*
    }
    respond @metrics "Forbidden: Internal metrics endpoint" 403

    # Reverse proxy application traffic
    reverse_proxy api:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Public Grafana Monitoring Portal
grafana.{$DOMAIN:localhost} {
    reverse_proxy grafana:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
