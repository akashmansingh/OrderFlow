# Where the dev/preview server forwards /api (the Go API from docker compose)
VITE_API_TARGET=http://localhost:8080

# Base URL the browser calls. Keep /api to go through the proxy.
# If the API lives on another origin, it must allow CORS and expose the
# `traceparent` header (Access-Control-Expose-Headers) for the trace inspector.
VITE_API_URL=/api

# Observability links used by the trace inspector
VITE_JAEGER_URL=http://localhost:16686
VITE_GRAFANA_URL=http://localhost:3000
