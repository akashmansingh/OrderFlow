APP_ENV=development
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://orderflow:local-dev-password@postgres:5432/orderflow?sslmode=disable
DATABASE_TIMEOUT=5
RESERVATION_HOLD_SECONDS=600
JWT_SECRET=REPLACE_ME
JWT_ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=orderflow
JWT_AUDIENCE=orderflow-api
KAFKA_BROKERS=redpanda:9092
KAFKA_TOPIC=reservation-events
KAFKA_GROUP_ID=orderflow-workflow-worker
WORKER_POLL_SECONDS=1
SIMULATED_PAYMENT_RESULT=approve
# auto: the worker settles holds by itself (default; benchmarks use this).
# checkout: the customer presses "Pay now"; set the same value for the api and worker.
PAYMENT_MODE=auto
# Checkout mode only: simulated processing time before an attempt settles.
PAYMENT_PROCESSING_SECONDS=3
REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=
REDIS_TIMEOUT=1
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_RESERVATION_PER_MINUTE=10
CACHE_SOLD_OUT_TTL=5

# Benchmark & load-testing toggles (default true in production/development)
ORDERFLOW_CACHE_ENABLED=true
ORDERFLOW_SOLDOUT_FASTPATH=true
ORDERFLOW_RATE_LIMIT_ENABLED=true
# Set LOAD_TEST_MODE=true only during local load testing to bypass login auth bottlenecks.
# Forbidden in production.
LOAD_TEST_MODE=false

# Distributed Tracing (OpenTelemetry & Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
ORDERFLOW_TRACING_ENABLED=true

POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=local-dev-password

PGADMIN_DEFAULT_EMAIL=admin@orderflow.example
PGADMIN_DEFAULT_PASSWORD=local-dev-password
