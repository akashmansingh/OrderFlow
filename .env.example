APP_ENV=development
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://orderflow:local-dev-password@postgres:5432/orderflow?sslmode=disable
DATABASE_TIMEOUT=5
RESERVATION_HOLD_SECONDS=600
JWT_SECRET=REPLACE_ME
JWT_ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=orderflow
JWT_AUDIENCE=orderflow-api
KAFKA_BROKERS=redpanda:9092
KAFKA_TOPIC=reservation-events
KAFKA_GROUP_ID=orderflow-workflow-worker
WORKER_POLL_SECONDS=1
SIMULATED_PAYMENT_RESULT=approve
REDIS_ADDRESS=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_TIMEOUT=1
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_RESERVATION_PER_MINUTE=10
CACHE_SOLD_OUT_TTL=5

POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=local-dev-password

PGADMIN_DEFAULT_EMAIL=admin@orderflow.example
PGADMIN_DEFAULT_PASSWORD=local-dev-password
